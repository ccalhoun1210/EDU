*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
crash.log

# customer / regulated data must never enter the repo
/data/
/uploads/
/evidence/
*.csv
*.xlsx
*.sqlite
!docs/**/*.csv

# editor & OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# claude code local overrides
.claude/settings.local.json

# next generated types
next-env.d.ts
