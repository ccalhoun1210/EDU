# ---------------------------------------------------------------------------
# Copy to .env.local for development. Never commit a populated .env file.
# Production values live in Vercel project settings, not in the repo.
# ---------------------------------------------------------------------------

# Neon Postgres. Use the POOLED url for the app (serverless functions open many
# short-lived connections) and the DIRECT url for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# The application must connect as a role with RLS FORCED, never as the schema owner.
# See docs/adrs/0004-tenant-isolation-with-postgres-rls.md
DATABASE_APP_ROLE=complianceos_app

# Inngest — durable background work (imports, evaluations, report generation).
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Vercel Blob — source files and evidence objects.
BLOB_READ_WRITE_TOKEN=

# Session sealing. At least 32 characters, and required whenever DATABASE_URL is set:
# the app refuses to start with district data behind a session it cannot seal.
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# Demonstration sign-in. The UUID of the tenant whose users may be impersonated without
# authentication, for walking through the product before a district's identity provider is
# federated. An id and not a slug, because resolving a slug would need the tenant context
# the lookup is trying to establish. Refused outright on a production deployment.
# Leave empty unless you mean it.
DEMO_TENANT_ID=

# Auth provider (WorkOS or Auth0 behind the abstraction in packages/identity).
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
AUTH_ISSUER_URL=

# Optional AI gateway. Advisory output only — never a compliance decision.
# See docs/adrs/0005-ai-is-advisory-only.md
AI_GATEWAY_API_KEY=
