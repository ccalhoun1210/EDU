# ---------------------------------------------------------------------------
# Copy to .env.local for development. Never commit a populated .env file.
# Production values live in Vercel project settings, not in the repo.
# ---------------------------------------------------------------------------

# Neon Postgres. Use the POOLED url for the app (serverless functions open many
# short-lived connections) and the DIRECT url for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# The application must connect as a role with RLS FORCED, never as the schema owner.
# See docs/adrs/0004-tenant-isolation-with-postgres-rls.md
DATABASE_APP_ROLE=complianceos_app

# Inngest — durable background work (imports, evaluations, report generation).
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Vercel Blob — source files and evidence objects.
BLOB_READ_WRITE_TOKEN=

# Auth provider (WorkOS or Auth0 behind the abstraction in packages/auth).
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
AUTH_ISSUER_URL=

# Optional AI gateway. Advisory output only — never a compliance decision.
# See docs/adrs/0005-ai-is-advisory-only.md
AI_GATEWAY_API_KEY=
